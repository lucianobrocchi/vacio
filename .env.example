# Variables de Corte. Copiá este archivo a `.env` y completá los valores.
# En producción viven en Vercel → Settings → Environment Variables.
#
# OJO: las VITE_* se compilan DENTRO de la app (las ve cualquiera que abra el
# navegador). Nunca pongas una clave secreta en una variable VITE_.
# Y después de cambiarlas en Vercel hay que hacer Redeploy: si no, la app
# sigue con los valores viejos.

# ── Navegador (públicas) ────────────────────────────────────────────────
# Proyecto de Supabase. Sin barra final y sin /rest/v1.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave pública ("publishable"): Supabase → Settings → API Keys.
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx

# Apagado de emergencia del sync en vivo para TODOS (dejar vacío = encendido).
# VITE_SYNC_VIVO=0

# Client ID de Google, para conectar Google Calendar en un toque (opcional).
# VITE_GOOGLE_CLIENT_ID=

# ── Servidor (SECRETAS: solo en Vercel, nunca en el navegador) ──────────
# Mismo proyecto que VITE_SUPABASE_URL.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave secreta ("secret"/service_role). NO compartir por chat ni commitear.
SUPABASE_SERVICE_KEY=sb_secret_xxxxxxxx

# Clave del panel /admin (la inventás vos). Con esto se crean y se revocan
# las membresías de TODAS las barberías: tratala como una contraseña.
ADMIN_TOKEN=

# Asistente IA de la app (opcional; sin esto cae a la ayuda con FAQ).
# ANTHROPIC_API_KEY=

# Webhook donde llega el feedback de los usuarios (opcional).
# FEEDBACK_WEBHOOK_URL=
